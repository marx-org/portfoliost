FROM ghcr.io/marx-org/base-node:22-alpine@sha256:3f029b552d9d4c61751b88bed969e5bc1010a776a43b749795426e5bd692f2b1

WORKDIR /app

COPY mocks/db-seed/package.json ./
RUN npm install --omit=dev

COPY mocks/db-seed/ ./
COPY mocks/shared/data/raw/news_articles_all.json ./fixtures/news_articles_all.json

CMD ["node", "run.mjs"]
