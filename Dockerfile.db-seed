FROM ghcr.io/marx-org/base-node:22-alpine@sha256:a3d3cea2575a542fe6f3d0b931f214027870ddf2cbcef488fc60b913c8f9c40d

WORKDIR /app

COPY mocks/db-seed/package.json ./
RUN npm install --omit=dev

COPY mocks/db-seed/ ./
COPY mocks/shared/data/raw/news_articles_all.json ./fixtures/news_articles_all.json

CMD ["node", "run.mjs"]
