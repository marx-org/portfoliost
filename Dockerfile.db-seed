FROM ghcr.io/marx-org/base-node:22-alpine@sha256:4c555748c9819babb757c7c328a12443b9d242edcfcc11cd196c24623dc704dd

WORKDIR /app

COPY mocks/db-seed/package.json ./
RUN npm install --omit=dev

COPY mocks/db-seed/ ./
COPY mocks/shared/data/raw/news_articles_all.json ./fixtures/news_articles_all.json

CMD ["node", "run.mjs"]
