# Google Sheets sync (plan §24.8) — copy to sheets-sync.env and fill in.
# Only the GOOGLE_* values are secrets; WALLETS_API_URL / WALLETS_API_TOKEN /
# INSTRUMENTS_DATABASE_URL are set by docker-compose.yml.
#
# OAuth: a Google Cloud Desktop app with the
# https://www.googleapis.com/auth/spreadsheets.readonly scope; the refresh
# token is exchanged once per Job run (sheets-client.ts).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
