{
  "name": "portfoliost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfoliost - a loose Vue 3 copy of the Example service.ai investment portfolio tracker, backed by the local Example service API mock",
  "scripts": {
    "predev": "npm --prefix tools/contracts-generator ci",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "prepreview": "npm --prefix tools/contracts-generator ci",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:vue && tsc --noEmit -p tsconfig.ts7.json",
    "typecheck:vue": "npm --prefix tools/contracts-generator ci && npm --prefix tools/contracts-generator run typecheck:vue",
    "pretest": "npm --prefix tools/contracts-generator ci",
    "test": "vitest run",
    "pretest:watch": "npm --prefix tools/contracts-generator ci",
    "test:watch": "vitest",
    "pretest:e2e": "npm --prefix tools/contracts-generator ci && bash scripts/reset-mock-state.sh",
    "test:e2e": "playwright test",
    "test:mock": "node mocks/tests/run.mjs",
    "test:stack": "node scripts/instruments-stack-test.mjs",
    "mock:start": "node mocks/gateway/index.js",
    "mock:seed": "node scripts/regen-seed.mjs",
    "gen:types": "npm --prefix tools/contracts-generator ci && npm --prefix tools/contracts-generator run generate",
    "test:stack:wallets": "node scripts/wallets-stack-test.mjs",
    "test:stack:portfolios": "node scripts/portfolios-stack-test.mjs",
    "test:stack:listing-overrides": "node scripts/listing-overrides-stack-test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@marx-org/contracts": "^1.6.81",
    "@vue-flow/core": "^1.48.2",
    "apexcharts": "^8.5.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.7"
  }
}
