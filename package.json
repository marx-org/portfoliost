{
  "name": "portfoliost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfoliost - a loose Vue 3 copy of the Example service.ai investment portfolio tracker, backed by the local Example service API mock",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "bash scripts/reset-mock-state.sh",
    "test:e2e": "playwright test",
    "test:mock": "node mocks/tests/run.mjs",
    "test:stack": "node scripts/instruments-stack-test.mjs",
    "mock:start": "node mocks/gateway/index.js",
    "mock:seed": "node scripts/regen-seed.mjs",
    "gen:types": "openapi-typescript node_modules/@marx2/contracts/openapi.yaml -o generated/api-types.d.ts",
    "test:stack:wallets": "node scripts/wallets-stack-test.mjs",
    "test:stack:portfolios": "node scripts/portfolios-stack-test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@marx2/contracts": "^1.6.24",
    "@vue-flow/core": "^1.48.2",
    "apexcharts": "^5.10.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^20.11.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.24"
  },
  "engines": {
    "node": ">=20"
  }
}
