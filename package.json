{
  "name": "portfoliost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfoliost - a loose Vue 3 copy of the Example service.ai investment portfolio tracker, backed by the local Example service API mock",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "bash scripts/reset-mock-state.sh",
    "test:e2e": "playwright test",
    "test:mock": "node mocks/tests/run.mjs",
    "test:stack": "node scripts/instruments-stack-test.mjs",
    "mock:start": "node mocks/gateway/index.js",
    "mock:seed": "node scripts/regen-seed.mjs",
    "gen:types": "openapi-typescript node_modules/@marx-org/contracts/openapi.yaml -o generated/api-types.d.ts",
    "test:stack:wallets": "node scripts/wallets-stack-test.mjs",
    "test:stack:portfolios": "node scripts/portfolios-stack-test.mjs",
    "test:stack:listing-overrides": "node scripts/listing-overrides-stack-test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@marx-org/contracts": "^1.6.77",
    "@vue-flow/core": "^1.48.2",
    "apexcharts": "^8.3.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20"
  }
}
