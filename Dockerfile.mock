FROM node:22-alpine

WORKDIR /app

ARG NODE_AUTH_TOKEN=""

COPY package.json package-lock.json .npmrc ./
RUN sed -i "s|\${NODE_AUTH_TOKEN}|${NODE_AUTH_TOKEN}|g" .npmrc && npm ci --omit=dev && rm .npmrc

COPY mocks/ mocks/
COPY scripts/ scripts/

ENV PORT=4010
ENV HOST=0.0.0.0
EXPOSE 4010

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:4010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "mocks/gateway/index.js"]
