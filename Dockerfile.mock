# syntax=docker/dockerfile:1

FROM ghcr.io/marx-org/base-node:22-alpine@sha256:3f029b552d9d4c61751b88bed969e5bc1010a776a43b749795426e5bd692f2b1

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN --mount=type=secret,id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN,required=true \
    printf '%s\n' '//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}' >> .npmrc && \
    npm ci --omit=dev && \
    rm -f .npmrc

COPY mocks/ mocks/
COPY scripts/ scripts/

ENV PORT=4010
ENV HOST=0.0.0.0
EXPOSE 4010

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:4010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "mocks/gateway/index.js"]
