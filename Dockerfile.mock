FROM node:22-alpine

WORKDIR /app

COPY package.json ./
COPY mocks/ mocks/
COPY scripts/ scripts/
# shared FX/currency helpers (fees-and-custom-fx D27) — vendored built dist
COPY node_modules/@marx2/contracts/package.json node_modules/@marx2/contracts/package.json
COPY node_modules/@marx2/contracts/dist/ node_modules/@marx2/contracts/dist/

ENV PORT=4010
ENV HOST=0.0.0.0
EXPOSE 4010

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:4010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "mocks/gateway/index.js"]
