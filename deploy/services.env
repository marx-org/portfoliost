# Single source of truth for backend module base URLs (proposal D3).
# Consumed by the nginx gateway (envsubst into upstreams) and by any
# backend module calling another module internally.
#
# Flip a module mock -> real by pointing its key at the module service,
# then recreate consumers: docker compose up -d gateway <consuming modules>.
# Kubernetes: this file maps 1:1 to a ConfigMap applied via envFrom.

# users-auth module (repo: portfoliost-users-auth). Real: http://users-auth:3000
API_USERS_AUTH_URL=http://example-service-mock:4010
API_PORTFOLIOS_URL=http://wallets:3000
API_WALLETS_URL=http://wallets:3000
# instruments module (repo: portfoliost-instruments) — real backend stack
# (instruments → cachest → openst). Fall back to the mock by pointing this
# at http://example-service-mock:4010 and recreating the gateway; verify either way
# with `npm run test:stack`.
API_INSTRUMENTS_URL=http://instruments:3000
API_WATCHLISTS_URL=http://example-service-mock:4010
API_NOTIFICATIONS_URL=http://example-service-mock:4010
API_NEWS_URL=http://example-service-mock:4010
API_BILLING_URL=http://example-service-mock:4010
API_CHARTING_URL=http://example-service-mock:4010
API_COPILOT_URL=http://example-service-mock:4010
API_LOGOS_URL=http://instruments:3000
API_EXCHANGE_RATES_URL=http://example-service-mock:4010
API_SNAPTRADE_URL=http://example-service-mock:4010
API_PUBLIC_URL=http://example-service-mock:4010
API_BACKEND_URL=http://example-service-mock:4010
API_ADMIN_URL=http://admin:3000
